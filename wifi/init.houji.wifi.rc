# Started by GUI2 only when the user enables Wi-Fi.
service wpa_supplicant /system/bin/houji-wifi-control run
    user root
    group root wifi inet net_raw net_admin
    seclabel u:r:recovery:s0
    disabled
    oneshot

service houji.wifi-dhcp /system/bin/houji-wifi-control dhcp-worker
    user root
    group root wifi inet net_raw net_admin
    seclabel u:r:recovery:s0
    disabled
    oneshot
    timeout_period 45

service houji.wifi-cleanup /system/bin/houji-wifi-control cleanup
    user root
    group root wifi inet net_raw net_admin
    seclabel u:r:recovery:s0
    disabled
    oneshot

on property:init.svc.wpa_supplicant=stopped
    start houji.wifi-cleanup
